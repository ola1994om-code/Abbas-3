<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>المنصة الرسمية لشركة عباس للزجاج</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
:root{
--play:#01875f;
--play-dark:#056449;
--play-soft:#e6f3ef;
--blue:#1a73e8;
--bg:#ffffff;
--surface:#f8fafc;
--text:#202124;
--muted:#5f6368;
--border:#e2e8f0;
--danger:#d93025;
}
*{box-sizing:border-box;font-variant-numeric:tabular-nums lining-nums}
html,body{margin:0;padding:0;width:100%;overflow-x:hidden;background:var(--bg);color:var(--text);font-family:'Segoe UI',Tahoma,Arial,sans-serif}
.en-num,input[type="number"],input[type="url"]{font-family:Arial,Helvetica,sans-serif}
.hidden{display:none!important}

/* الهيدر الجديد الواضح بدون قص العنوان */
header{position:sticky;top:0;z-index:100;background:#ffffff;border-bottom:2px solid var(--border);padding:12px 14px 10px;box-shadow:0 3px 10px rgba(15,23,42,.06)}
.header-inner{max-width:980px;margin:0 auto;display:flex;flex-direction:column;gap:10px}
.brand-row{display:flex;align-items:center;gap:12px;width:100%}
.brand-logo-wrap{width:62px;height:62px;border-radius:14px;border:1.5px solid #cbd5e1;background:#ffffff;display:flex;align-items:center;justify-content:center;overflow:hidden;flex-shrink:0;box-shadow:0 3px 8px rgba(15,23,42,.1)}
.brand-logo-img{width:100%;height:100%;object-fit:contain;padding:3px;background:#fff}
.brand-badge-fallback{width:100%;height:100%;background:linear-gradient(135deg,#01875f,#0b57d0);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:1.7rem}
.brand-text{flex:1;min-width:0}
.brand-title{margin:0;font-size:1.25rem;font-weight:900;color:#0f172a;line-height:1.35;white-space:normal;word-break:break-word}
.brand-sub{margin-top:3px;font-size:.82rem;color:var(--play-dark);font-weight:800}
.header-btns{display:flex;align-items:center;gap:8px;width:100%}
.btn-top{flex:1;border:1.5px solid var(--border);background:var(--surface);color:var(--text);padding:8px 12px;border-radius:10px;font-size:.86rem;font-weight:800;cursor:pointer;transition:.2s;text-align:center}
.btn-top:active{transform:scale(.97)}
.btn-top-admin{border-color:var(--play);color:var(--play-dark);background:var(--play-soft)}

@media(min-width:700px){
.header-inner{flex-direction:row;align-items:center;justify-content:space-between}
.header-btns{width:auto;flex-shrink:0}
.btn-top{flex:none;padding:8px 16px}
.brand-title{font-size:1.4rem}
}

/* شريط البحث والتصنيفات */
.search-wrap{max-width:980px;margin:12px auto 0;padding:0 14px}
.search-box{display:flex;align-items:center;gap:8px;background:var(--surface);border:1.5px solid #cbd5e1;border-radius:999px;padding:6px 14px;transition:.2s}
.search-box:focus-within{border-color:var(--play);background:#fff;box-shadow:0 0 0 3px rgba(1,135,95,.12)}
.search-box input{border:none;background:transparent;width:100%;padding:6px 2px;font-size:.95rem;font-family:inherit;color:var(--text);outline:none}
.cats-bar{max-width:980px;margin:12px auto 6px;padding:0 14px 4px;display:flex;gap:8px;overflow-x:auto;scrollbar-width:none}
.cats-bar::-webkit-scrollbar{display:none}
.cat-chip{flex-shrink:0;padding:7px 14px;border-radius:999px;border:1.5px solid var(--border);background:#fff;color:var(--muted);font-size:.84rem;font-weight:800;cursor:pointer;transition:.2s}
.cat-chip.active{background:var(--play-soft);color:var(--play-dark);border-color:var(--play)}

/* المحتوى الرئيسي */
.container{max-width:980px;margin:0 auto;padding:8px 14px 40px}
.section-head{display:flex;justify-content:space-between;align-items:center;margin:8px 0 12px}
.section-head h2{margin:0;font-size:1.05rem;font-weight:900;color:var(--text)}
.count-pill{background:var(--surface);border:1px solid var(--border);color:var(--muted);padding:3px 10px;border-radius:999px;font-size:.78rem;font-weight:800}

/* شبكة التطبيقات */
.apps-grid{display:grid;grid-template-columns:1fr;gap:12px}
@media(min-width:680px){.apps-grid{grid-template-columns:repeat(2,1fr)}}
@media(min-width:960px){.apps-grid{grid-template-columns:repeat(3,1fr)}}

.app-card{background:#fff;border:1.5px solid var(--border);border-radius:16px;padding:14px;display:flex;flex-direction:column;gap:12px;transition:.2s;box-shadow:0 2px 8px rgba(15,23,42,.04)}
.app-card:hover{border-color:#94a3b8;box-shadow:0 6px 16px rgba(15,23,42,.08)}
.app-main{display:flex;align-items:flex-start;gap:12px}
.app-icon{width:64px;height:64px;border-radius:16px;flex-shrink:0;object-fit:cover;border:1px solid #e2e8f0;background:var(--surface);box-shadow:0 2px 6px rgba(0,0,0,.08)}
.app-icon-fallback{width:64px;height:64px;border-radius:16px;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:1.5rem;font-weight:900;color:#fff;background:linear-gradient(135deg,#01875f,#1a73e8);box-shadow:0 2px 6px rgba(0,0,0,.1)}
.app-info{flex:1;min-width:0}
.app-title{margin:0 0 4px;font-size:1.04rem;font-weight:900;color:var(--text);line-height:1.35}
.app-cat{display:inline-block;background:var(--play-soft);color:var(--play-dark);padding:2px 8px;border-radius:6px;font-size:.74rem;font-weight:800;margin-bottom:5px}
.app-desc{margin:0;font-size:.83rem;color:var(--muted);line-height:1.45;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.app-url-preview{font-size:.74rem;color:#64748b;background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:5px 8px;direction:ltr;text-align:left;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-family:Arial,sans-serif}
.app-actions{display:grid;grid-template-columns:1.2fr 1fr;gap:8px}
.btn-open{background:var(--play);color:#fff;border:none;padding:9px 10px;border-radius:10px;font-size:.88rem;font-weight:900;cursor:pointer;text-decoration:none;text-align:center;display:flex;align-items:center;justify-content:center;gap:5px}
.btn-open:active{background:var(--play-dark);transform:scale(.98)}
.btn-copy{background:#fff;color:var(--play-dark);border:1.5px solid var(--play);padding:9px 10px;border-radius:10px;font-size:.86rem;font-weight:900;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:5px}
.btn-copy:active{background:var(--play-soft);transform:scale(.98)}

/* لوحة الإدارة */
.admin-panel{background:var(--surface);border:2px solid var(--play);border-radius:16px;padding:16px;margin-bottom:18px}
.admin-head{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;border-bottom:1.5px solid #cbd5e1;padding-bottom:10px;margin-bottom:14px}
.admin-head h3{margin:0;color:var(--play-dark);font-size:1.05rem}
.brand-admin-box{background:#eff6ff;border:1.5px solid #93c5fd;border-radius:12px;padding:12px;margin-bottom:16px}
.brand-admin-box h4{margin:0 0 10px;color:#1e3a8a;font-size:.96rem}
.form-grid{display:grid;grid-template-columns:1fr;gap:10px;margin-bottom:10px}
@media(min-width:680px){.form-grid.cols-2{grid-template-columns:1fr 1fr}.form-grid.cols-3{grid-template-columns:1.4fr 1fr .6fr}}
label{display:block;font-size:.83rem;font-weight:800;color:#334155;margin-bottom:4px}
.inp{width:100%;padding:10px;border:1.5px solid #cbd5e1;border-radius:9px;font-family:inherit;font-size:.94rem;background:#fff;color:var(--text)}
.inp:focus{outline:none;border-color:var(--play);box-shadow:0 0 0 3px rgba(1,135,95,.12)}
.img-upload-box{display:flex;align-items:center;gap:12px;background:#fff;border:1.5px dashed #94a3b8;border-radius:10px;padding:10px;flex-wrap:wrap}
.img-preview{width:58px;height:58px;border-radius:12px;object-fit:contain;border:1px solid #cbd5e1;background:#fff;padding:2px}
.btn-save{background:var(--play);color:#fff;border:none;padding:12px;border-radius:10px;width:100%;font-size:.98rem;font-weight:900;cursor:pointer}
.btn-save:disabled{background:#94a3b8;cursor:not-allowed}
.admin-item-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px;border-top:1px dashed #cbd5e1;padding-top:10px}
.btn-edit{background:#1a73e8;color:#fff;border:none;padding:7px;border-radius:8px;font-size:.82rem;font-weight:800;cursor:pointer}
.btn-del{background:var(--danger);color:#fff;border:none;padding:7px;border-radius:8px;font-size:.82rem;font-weight:800;cursor:pointer}

/* نافذة دخول الإدارة */
.modal{display:none;position:fixed;inset:0;background:rgba(15,23,42,.72);z-index:2000;justify-content:center;align-items:center;padding:14px}
.modal-box{background:#fff;width:100%;max-width:370px;border-radius:16px;padding:20px;box-shadow:0 20px 45px rgba(0,0,0,.3);text-align:center}
.modal-box h3{margin:0 0 6px;color:var(--play-dark);font-size:1.25rem}
.modal-box p{margin:0 0 14px;color:var(--muted);font-size:.86rem;font-weight:700}

#toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%) translateY(90px);background:#202124;color:#fff;padding:10px 18px;border-radius:999px;font-size:.88rem;font-weight:800;z-index:3000;transition:transform .25s ease;box-shadow:0 6px 20px rgba(0,0,0,.25);white-space:nowrap}
#toast.show{transform:translateX(-50%) translateY(0)}
.empty-state{text-align:center;padding:38px 16px;background:var(--surface);border:2px dashed #cbd5e1;border-radius:14px;color:var(--muted);font-weight:800}
</style>
</head>
<body>

<header>
<div class="header-inner">
<div class="brand-row">
<div class="brand-logo-wrap">
<img id="header-logo-img" class="brand-logo-img hidden" alt="لوغو الشركة">
<div id="header-logo-fallback" class="brand-badge-fallback">ع</div>
</div>
<div class="brand-text">
<h1 id="header-title" class="brand-title">المنصة الرسمية لشركة عباس للزجاج</h1>
<div id="header-sub" class="brand-sub">بوابة الأقسام والروابط الرسمية</div>
</div>
</div>
<div class="header-btns">
<button class="btn-top" onclick="loadLinks(true)">تحديث</button>
<button id="btn-admin-toggle" class="btn-top btn-top-admin" onclick="onAdminBtnClick()">الإدارة</button>
</div>
</div>
</header>

<div class="search-wrap">
<div class="search-box">
<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#5f6368" stroke-width="2.2"><circle cx="11" cy="11" r="7"></circle><line x1="20" y1="20" x2="16.65" y2="16.65"></line></svg>
<input type="text" id="search-input" placeholder="ابحث عن قسم أو تطبيق..." onkeyup="renderStore()">
</div>
</div>

<div class="cats-bar" id="cats-bar"></div>

<div class="container">
<!-- لوحة الإدارة -->
<div id="admin-panel" class="admin-panel hidden">
<div class="admin-head">
<h3>لوحة إدارة المنصة</h3>
<button class="btn-top" style="flex:none;border-color:#d93025;color:#d93025;padding:6px 12px" onclick="adminLogout()">خروج الإدارة</button>
</div>

<!-- إعداد لوغو الشركة الرئيسي -->
<div class="brand-admin-box">
<h4>لوغو وعنوان الشركة (يظهر في الأعلى لجميع المستخدمين)</h4>
<div class="form-grid cols-2">
<div>
<label>عنوان المنصة</label>
<input type="text" id="b-title" class="inp" value="المنصة الرسمية لشركة عباس للزجاج">
</div>
<div>
<label>الوصف أسفل العنوان</label>
<input type="text" id="b-sub" class="inp" value="بوابة الأقسام والروابط الرسمية">
</div>
</div>
<div class="img-upload-box" style="margin-bottom:10px">
<img id="b-logo-preview" class="img-preview hidden" alt="Logo">
<div style="flex:1;min-width:190px;display:flex;flex-direction:column;gap:6px">
<input type="file" id="b-logo-file" accept="image/*" onchange="onPickBrandLogo(event)" style="font-size:.84rem">
<input type="url" id="b-logo-url" class="inp en-num" placeholder="أو الصق رابط لوغو مباشر" oninput="onTypeBrandLogoUrl()" style="padding:7px 9px;font-size:.84rem;direction:ltr;text-align:left">
</div>
<button type="button" class="btn-top" style="flex:none;border-color:#d93025;color:#d93025" onclick="clearBrandLogo()">مسح اللوغو</button>
</div>
<button id="btn-save-brand" class="btn-save" style="background:#1a73e8;padding:10px" onclick="saveBrandSettings()">✓ حفظ لوغو وعنوان الشركة للجميع</button>
</div>

<!-- إضافة / تعديل قسم -->
<div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;margin-bottom:10px">
<h4 id="admin-form-title" style="margin:0;color:var(--play-dark);font-size:1rem">+ إضافة قسم / رابط جديد</h4>
<button id="btn-cancel-edit" class="btn-top hidden" style="flex:none;padding:5px 12px" onclick="resetAdminForm()">إلغاء التعديل</button>
</div>

<input type="hidden" id="edit-id" value="">

<div class="form-grid cols-3">
<div>
<label>اسم القسم / التطبيق *</label>
<input type="text" id="f-title" class="inp" placeholder="مثال: تطبيق المحاسبة والرواتب">
</div>
<div>
<label>التصنيف</label>
<select id="f-category" class="inp">
<option value="الإنتاج">الإنتاج</option>
<option value="الإدارة">الإدارة</option>
<option value="المحاسبة">المحاسبة</option>
<option value="البوابة والأمن">البوابة والأمن</option>
<option value="الدوام والعمال">الدوام والعمال</option>
<option value="المستودع">المستودع</option>
<option value="عام">عام</option>
</select>
</div>
<div>
<label>الترتيب</label>
<input type="number" id="f-order" class="inp en-num" value="1" min="0" style="direction:ltr;text-align:center">
</div>
</div>

<div class="form-grid cols-2">
<div>
<label>الرابط (URL) *</label>
<input type="url" id="f-url" class="inp en-num" placeholder="https://..." style="direction:ltr;text-align:left">
</div>
<div>
<label>وصف مختصر (اختياري)</label>
<input type="text" id="f-desc" class="inp" placeholder="مثال: إصدار الفواتير وكشف حساب الزبائن والرواتب">
</div>
</div>

<div style="margin-bottom:12px">
<label>صورة / أيقونة القسم (من الجهاز أو رابط صورة)</label>
<div class="img-upload-box">
<img id="f-img-preview" class="img-preview hidden" alt="Icon">
<div style="flex:1;min-width:190px;display:flex;flex-direction:column;gap:6px">
<input type="file" id="f-img-file" accept="image/*" onchange="onPickIconFile(event)" style="font-size:.84rem">
<input type="url" id="f-img-url" class="inp en-num" placeholder="أو الصق رابط صورة مباشر (اختياري)" oninput="onTypeImgUrl()" style="padding:7px 9px;font-size:.84rem;direction:ltr;text-align:left">
</div>
<button type="button" class="btn-top" style="flex:none;border-color:#d93025;color:#d93025" onclick="clearPickedIcon()">مسح الصورة</button>
</div>
</div>

<button id="btn-save-link" class="btn-save" onclick="saveLink()">✓ حفظ ونشر القسم في المنصة</button>
</div>

<div class="section-head">
<h2>الأقسام والتطبيقات المتاحة</h2>
<span id="apps-count" class="count-pill en-num">0</span>
</div>

<div id="apps-grid" class="apps-grid">
<div class="empty-state">جاري تحميل الأقسام...</div>
</div>
</div>

<!-- نافذة دخول الإدارة -->
<div id="login-modal" class="modal">
<div class="modal-box">
<h3>دخول قسم الإدارة</h3>
<p>مخصص لإضافة وتعديل روابط الأقسام ولوغو الشركة</p>
<input type="text" id="adm-user" class="inp" placeholder="اسم المستخدم" style="margin-bottom:10px;text-align:center">
<input type="password" id="adm-pass" class="inp en-num" placeholder="كلمة المرور" onkeydown="if(event.key==='Enter')doAdminLogin()" style="margin-bottom:14px;direction:ltr;text-align:center">
<div style="display:grid;grid-template-columns:1.4fr 1fr;gap:8px">
<button class="btn-save" onclick="doAdminLogin()" style="padding:10px">دخول</button>
<button class="btn-top" onclick="closeLoginModal()" style="border-radius:10px;padding:10px">إلغاء</button>
</div>
</div>
</div>

<div id="toast">تم النسخ ✓</div>

<script>
const SUPABASE_URL='https://kxesvjrvbbzgulyuddfv.supabase.co';
const SUPABASE_ANON_KEY='sb_publishable_F0Yy4QFZM5y4YkHMtb8YKg_WnOkGJKA';
const supabaseClient=window.supabase.createClient(SUPABASE_URL,SUPABASE_ANON_KEY);

const ADMIN_USER_NORM='ابو حسام';
const ADMIN_PASS='0990446436';
const SETTINGS_ROW_ID='__platform_settings__';
const CACHE_KEY='abbas_platform_links_v1';
const BRAND_CACHE_KEY='abbas_platform_brand_v1';

let links=[];
let activeCategory='الكل';
let isAdmin=sessionStorage.getItem('abbas_platform_admin')==='1';
let pickedImageData='';
let pickedBrandLogo='';
let toastTimer=null;
let brandSettings={
title:'المنصة الرسمية لشركة عباس للزجاج',
sub:'بوابة الأقسام والروابط الرسمية',
logo:''
};

function toEnDigits(s){
if(s===null||s===undefined)return '';
return String(s).replace(/[٠-٩]/g,d=>'٠١٢٣٤٥٦٧٨٩'.indexOf(d)).replace(/[۰-۹]/g,d=>'۰۱۲۳۴۵۶۷۸۹'.indexOf(d));
}

function normalizeName(s){
if(!s)return '';
return String(s).replace(/[\u064B-\u065F\u0640]/g,'').replace(/[أإآ]/g,'ا').replace(/ة/g,'ه').replace(/ى/g,'ي').replace(/\s+/g,' ').trim().toLowerCase();
}

function escapeHTML(s){
if(s===undefined||s===null)return '';
return String(s)
.replace(/&/g,'\x26amp;')
.replace(/</g,'\x26lt;')
.replace(/>/g,'\x26gt;')
.replace(/"/g,'\x26quot;')
.replace(/'/g,'\x26#39;');
}

function showToast(msg){
let el=document.getElementById('toast');
el.innerText=msg;
el.classList.add('show');
if(toastTimer)clearTimeout(toastTimer);
toastTimer=setTimeout(()=>el.classList.remove('show'),2200);
}

function copyLink(url){
if(!url)return;
if(navigator.clipboard && navigator.clipboard.writeText){
navigator.clipboard.writeText(url).then(()=>showToast('تم نسخ الرابط بنجاح ✓')).catch(()=>fallbackCopy(url));
}else{
fallbackCopy(url);
}
}

function fallbackCopy(text){
let ta=document.createElement('textarea');
ta.value=text;
ta.style.position='fixed';
ta.style.top='-9999px';
document.body.appendChild(ta);
ta.focus();
ta.select();
try{document.execCommand('copy');showToast('تم نسخ الرابط بنجاح ✓')}
catch(e){prompt('انسخ الرابط يدوياً:',text)}
document.body.removeChild(ta);
}

function normalizeUrl(u){
let s=(u||'').trim();
if(!s)return '';
if(!/^https?:\/\//i.test(s))s='https://'+s;
return s;
}

/* جلب اللوغو المشترك من الذاكرة المحلية كاحتياط */
function getFallbackLocalLogo(){
try{
let info=JSON.parse(localStorage.getItem('sys_company_info')||'{}');
let gate=JSON.parse(localStorage.getItem('gate_company_settings')||'{}');
return info.logo || localStorage.getItem('sys_logo') || localStorage.getItem('sys_company_logo') || gate.logo || '';
}catch(e){return ''}
}

function applyBrandUI(){
let finalTitle=brandSettings.title||'المنصة الرسمية لشركة عباس للزجاج';
let finalSub=brandSettings.sub||'بوابة الأقسام والروابط الرسمية';
let finalLogo=brandSettings.logo||getFallbackLocalLogo();

document.getElementById('header-title').innerText=finalTitle;
document.getElementById('header-sub').innerText=finalSub;

let img=document.getElementById('header-logo-img');
let fb=document.getElementById('header-logo-fallback');
if(finalLogo){
img.src=finalLogo;
img.classList.remove('hidden');
fb.classList.add('hidden');
}else{
img.src='';
img.classList.add('hidden');
fb.classList.remove('hidden');
}

document.getElementById('b-title').value=finalTitle;
document.getElementById('b-sub').value=finalSub;
pickedBrandLogo=finalLogo;
document.getElementById('b-logo-url').value=(finalLogo && !finalLogo.startsWith('data:'))?finalLogo:'';
updateBrandLogoPreview();
}

function onPickBrandLogo(ev){
let f=ev.target.files && ev.target.files[0];
if(!f)return;
let r=new FileReader();
r.onload=e=>{
let img=new Image();
img.onload=()=>{
let maxS=260,w=img.width,h=img.height;
if(w>maxS || h>maxS){
if(w>h){h=Math.round(h*(maxS/w));w=maxS}
else{w=Math.round(w*(maxS/h));h=maxS}
}
let c=document.createElement('canvas');
c.width=w;c.height=h;
c.getContext('2d').drawImage(img,0,0,w,h);
pickedBrandLogo=c.toDataURL('image/png');
document.getElementById('b-logo-url').value='';
updateBrandLogoPreview();
};
img.src=e.target.result;
};
r.readAsDataURL(f);
}

function onTypeBrandLogoUrl(){
let u=document.getElementById('b-logo-url').value.trim();
pickedBrandLogo=u;
if(u)document.getElementById('b-logo-file').value='';
updateBrandLogoPreview();
}

function clearBrandLogo(){
pickedBrandLogo='';
document.getElementById('b-logo-file').value='';
document.getElementById('b-logo-url').value='';
updateBrandLogoPreview();
}

function updateBrandLogoPreview(){
let prev=document.getElementById('b-logo-preview');
if(pickedBrandLogo){prev.src=pickedBrandLogo;prev.classList.remove('hidden')}
else{prev.src='';prev.classList.add('hidden')}
}

async function saveBrandSettings(){
if(!isAdmin)return;
let t=document.getElementById('b-title').value.trim()||'المنصة الرسمية لشركة عباس للزجاج';
let s=document.getElementById('b-sub').value.trim()||'بوابة الأقسام والروابط الرسمية';
let row={
id:SETTINGS_ROW_ID,
title:t,
category:'__sys__',
description:s,
url:'#',
image_data:pickedBrandLogo||'',
sort_order:-999
};
let btn=document.getElementById('btn-save-brand');
btn.disabled=true;btn.innerText='جاري حفظ اللوغو...';
try{
const{error}=await supabaseClient.from('platform_links').upsert([row]);
if(error)return alert('تعذر حفظ اللوغو على السيرفر: '+error.message);
brandSettings={title:t,sub:s,logo:pickedBrandLogo||''};
localStorage.setItem(BRAND_CACHE_KEY,JSON.stringify(brandSettings));
if(pickedBrandLogo)localStorage.setItem('sys_logo',pickedBrandLogo);
applyBrandUI();
showToast('تم حفظ لوغو وعنوان الشركة للجميع ✓');
}catch(e){
alert('تعذر الاتصال بالسيرفر، تأكد من الإنترنت وأعد المحاولة.');
}finally{
btn.disabled=false;btn.innerText='✓ حفظ لوغو وعنوان الشركة للجميع';
}
}

/* الإدارة */
function onAdminBtnClick(){
if(isAdmin){
let panel=document.getElementById('admin-panel');
panel.classList.toggle('hidden');
if(!panel.classList.contains('hidden'))panel.scrollIntoView({behavior:'smooth'});
}else{
document.getElementById('adm-user').value='';
document.getElementById('adm-pass').value='';
document.getElementById('login-modal').style.display='flex';
setTimeout(()=>document.getElementById('adm-user').focus(),50);
}
}

function closeLoginModal(){document.getElementById('login-modal').style.display='none'}

function doAdminLogin(){
let u=normalizeName(document.getElementById('adm-user').value);
let p=toEnDigits(document.getElementById('adm-pass').value).trim();
if(u===normalizeName(ADMIN_USER_NORM) && p===ADMIN_PASS){
isAdmin=true;
sessionStorage.setItem('abbas_platform_admin','1');
closeLoginModal();
applyAdminUI();
showToast('تم دخول الإدارة ✓');
}else{
alert('اسم المستخدم أو كلمة المرور غير صحيحة!');
}
}

function adminLogout(){
isAdmin=false;
sessionStorage.removeItem('abbas_platform_admin');
resetAdminForm();
applyAdminUI();
showToast('تم تسجيل الخروج من الإدارة');
}

function applyAdminUI(){
let panel=document.getElementById('admin-panel');
let btn=document.getElementById('btn-admin-toggle');
if(isAdmin){panel.classList.remove('hidden');btn.innerText='لوحة الإدارة ●'}
else{panel.classList.add('hidden');btn.innerText='الإدارة'}
renderStore();
}

/* أيقونة القسم */
function onPickIconFile(ev){
let f=ev.target.files && ev.target.files[0];
if(!f)return;
let r=new FileReader();
r.onload=e=>{
let img=new Image();
img.onload=()=>{
let maxS=256,w=img.width,h=img.height;
if(w>maxS || h>maxS){
if(w>h){h=Math.round(h*(maxS/w));w=maxS}
else{w=Math.round(w*(maxS/h));h=maxS}
}
let c=document.createElement('canvas');
c.width=w;c.height=h;
c.getContext('2d').drawImage(img,0,0,w,h);
pickedImageData=c.toDataURL('image/jpeg',0.82);
document.getElementById('f-img-url').value='';
updateIconPreview();
};
img.src=e.target.result;
};
r.readAsDataURL(f);
}

function onTypeImgUrl(){
let u=document.getElementById('f-img-url').value.trim();
pickedImageData=u;
if(u)document.getElementById('f-img-file').value='';
updateIconPreview();
}

function clearPickedIcon(){
pickedImageData='';
document.getElementById('f-img-file').value='';
document.getElementById('f-img-url').value='';
updateIconPreview();
}

function updateIconPreview(){
let prev=document.getElementById('f-img-preview');
if(pickedImageData){prev.src=pickedImageData;prev.classList.remove('hidden')}
else{prev.src='';prev.classList.add('hidden')}
}

function resetAdminForm(){
document.getElementById('edit-id').value='';
document.getElementById('f-title').value='';
document.getElementById('f-category').value='الإنتاج';
document.getElementById('f-order').value=links.length+1;
document.getElementById('f-url').value='';
document.getElementById('f-desc').value='';
clearPickedIcon();
document.getElementById('admin-form-title').innerText='+ إضافة قسم / رابط جديد';
document.getElementById('btn-save-link').innerText='✓ حفظ ونشر القسم في المنصة';
document.getElementById('btn-cancel-edit').classList.add('hidden');
}

function startEditLink(id){
if(!isAdmin)return;
let item=links.find(x=>String(x.id)===String(id));
if(!item)return;
document.getElementById('edit-id').value=item.id;
document.getElementById('f-title').value=item.title||'';
let catSel=document.getElementById('f-category');
if(item.category && !Array.from(catSel.options).some(o=>o.value===item.category)){
let opt=document.createElement('option');opt.value=item.category;opt.text=item.category;catSel.add(opt);
}
catSel.value=item.category||'عام';
document.getElementById('f-order').value=item.sort_order!==undefined?item.sort_order:1;
document.getElementById('f-url').value=item.url||'';
document.getElementById('f-desc').value=item.description||'';
pickedImageData=item.image_data||'';
document.getElementById('f-img-file').value='';
document.getElementById('f-img-url').value=(pickedImageData && !pickedImageData.startsWith('data:'))?pickedImageData:'';
updateIconPreview();
document.getElementById('admin-form-title').innerText='تعديل القسم: '+item.title;
document.getElementById('btn-save-link').innerText='✓ حفظ التعديلات';
document.getElementById('btn-cancel-edit').classList.remove('hidden');
document.getElementById('admin-panel').classList.remove('hidden');
document.getElementById('admin-panel').scrollIntoView({behavior:'smooth'});
}

async function saveLink(){
if(!isAdmin)return;
let editId=document.getElementById('edit-id').value;
let title=document.getElementById('f-title').value.trim();
let category=document.getElementById('f-category').value||'عام';
let sortOrder=parseInt(toEnDigits(document.getElementById('f-order').value))||0;
let url=normalizeUrl(document.getElementById('f-url').value);
let description=document.getElementById('f-desc').value.trim();

if(!title)return alert('الرجاء إدخال اسم القسم أو التطبيق!');
if(!url)return alert('الرجاء إدخال الرابط!');

let obj={id:editId||('lnk_'+Date.now()),title,category,description,url,image_data:pickedImageData||'',sort_order:sortOrder};

let btn=document.getElementById('btn-save-link');
btn.disabled=true;btn.innerText='جاري الحفظ...';
try{
const{error}=await supabaseClient.from('platform_links').upsert([obj]);
if(error)return alert('تعذر الحفظ على السيرفر: '+error.message);
let idx=links.findIndex(x=>String(x.id)===String(obj.id));
if(idx>=0)links[idx]=obj;else links.push(obj);
sortLinks();
localStorage.setItem(CACHE_KEY,JSON.stringify(links));
resetAdminForm();
renderCategories();
renderStore();
showToast(editId?'تم حفظ التعديلات ✓':'تم إضافة القسم بنجاح ✓');
}catch(e){
alert('تعذر الاتصال بالسيرفر، تأكد من الإنترنت وأعد المحاولة.');
}finally{
btn.disabled=false;
btn.innerText=document.getElementById('edit-id').value?'✓ حفظ التعديلات':'✓ حفظ ونشر القسم في المنصة';
}
}

async function deleteLink(id){
if(!isAdmin)return;
let item=links.find(x=>String(x.id)===String(id));
if(!item)return;
if(!confirm('هل أنت متأكد من حذف قسم "'+item.title+'"؟'))return;
try{
const{error}=await supabaseClient.from('platform_links').delete().eq('id',item.id);
if(error)return alert('تعذر الحذف من السيرفر: '+error.message);
links=links.filter(x=>String(x.id)!==String(id));
localStorage.setItem(CACHE_KEY,JSON.stringify(links));
renderCategories();
renderStore();
showToast('تم الحذف ✓');
}catch(e){alert('تعذر الاتصال بالسيرفر.')}
}

function sortLinks(){links.sort((a,b)=>(Number(a.sort_order)||0)-(Number(b.sort_order)||0))}

async function loadLinks(showMsg=false){
try{
const{data,error}=await supabaseClient.from('platform_links').select('*').order('sort_order',{ascending:true});
if(!error && Array.isArray(data)){
let cfgRow=data.find(x=>String(x.id)===SETTINGS_ROW_ID);
if(cfgRow){
brandSettings={
title:cfgRow.title||'المنصة الرسمية لشركة عباس للزجاج',
sub:cfgRow.description||'بوابة الأقسام والروابط الرسمية',
logo:cfgRow.image_data||''
};
localStorage.setItem(BRAND_CACHE_KEY,JSON.stringify(brandSettings));
applyBrandUI();
}
links=data.filter(x=>String(x.id)!==SETTINGS_ROW_ID);
sortLinks();
localStorage.setItem(CACHE_KEY,JSON.stringify(links));
if(showMsg)showToast('تم تحديث القائمة ✓');
}
}catch(e){
if(showMsg)showToast('يعمل على النسخة المحفوظة');
}
renderCategories();
renderStore();
if(isAdmin && !document.getElementById('edit-id').value){
document.getElementById('f-order').value=links.length+1;
}
}

function renderCategories(){
let set=new Set(['الكل']);
links.forEach(l=>{if(l.category)set.add(l.category)});
let cats=Array.from(set);
if(!cats.includes(activeCategory))activeCategory='الكل';
document.getElementById('cats-bar').innerHTML=cats.map(c=>
`<button class="cat-chip ${c===activeCategory?'active':''}" onclick="selectCategory('${escapeHTML(c)}')">${escapeHTML(c)}</button>`
).join('');
}

function selectCategory(cat){activeCategory=cat;renderCategories();renderStore()}

function renderStore(){
let q=(document.getElementById('search-input').value||'').toLowerCase().trim();
let filtered=links.filter(item=>{
if(activeCategory!=='الكل' && item.category!==activeCategory)return false;
if(!q)return true;
let hay=`${item.title||''} ${item.category||''} ${item.description||''} ${item.url||''}`.toLowerCase();
return hay.includes(q);
});

document.getElementById('apps-count').innerText=filtered.length;
let grid=document.getElementById('apps-grid');

if(!filtered.length){
grid.innerHTML=`<div class="empty-state" style="grid-column:1/-1">${links.length===0?'لم يتم إضافة أي أقسام بعد. ادخل إلى (الإدارة) لإضافة الروابط.':'لا توجد أقسام مطابقة للبحث.'}</div>`;
return;
}

grid.innerHTML=filtered.map(item=>{
let letter=(item.title||'ع').trim().charAt(0);
let iconHtml=item.image_data
?`<img class="app-icon" src="${escapeHTML(item.image_data)}" alt="${escapeHTML(item.title)}" onerror="this.style.display='none'">`
:`<div class="app-icon-fallback">${escapeHTML(letter)}</div>`;
let safeUrl=escapeHTML(item.url);
let adminBtns=isAdmin
?`<div class="admin-item-actions"><button class="btn-edit" onclick="startEditLink('${escapeHTML(item.id)}')">تعديل</button><button class="btn-del" onclick="deleteLink('${escapeHTML(item.id)}')">حذف</button></div>`
:'';

return `<div class="app-card">
<div class="app-main">
${iconHtml}
<div class="app-info">
<h3 class="app-title">${escapeHTML(item.title)}</h3>
<span class="app-cat">${escapeHTML(item.category||'عام')}</span>
${item.description?`<p class="app-desc">${escapeHTML(item.description)}</p>`:''}
</div>
</div>
<div class="app-url-preview">${safeUrl}</div>
<div class="app-actions">
<a class="btn-open" href="${safeUrl}" target="_blank" rel="noopener">فتح القسم</a>
<button class="btn-copy" onclick="copyLink('${safeUrl.replace(/'/g,'')}')">نسخ الرابط</button>
</div>
${adminBtns}
</div>`;
}).join('');
}

/* التشغيل الأولي */
try{
let bCache=JSON.parse(localStorage.getItem(BRAND_CACHE_KEY)||'null');
if(bCache)brandSettings=bCache;
let cached=JSON.parse(localStorage.getItem(CACHE_KEY)||'[]');
if(Array.isArray(cached) && cached.length){links=cached.filter(x=>String(x.id)!==SETTINGS_ROW_ID);sortLinks()}
}catch(e){}
applyBrandUI();
applyAdminUI();
renderCategories();
renderStore();
loadLinks(false);
</script>
</body>
</html>
